# Normalização de quebras de linha e encoding
* text=auto eol=lf

# Arquivos de texto e marcação
*.md text eol=lf
*.json text eol=lf
*.html text eol=lf
*.xhtml text eol=lf
*.xml text eol=lf
*.opf text eol=lf
*.ncx text eol=lf
*.css text eol=lf
*.txt text eol=lf
*.py text eol=lf
*.cmd text eol=crlf
